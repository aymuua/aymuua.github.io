<% if (page.tag) { %>
<section class="archive-page">
  <header class="page-head">
    <span class="page-kicker">TAG</span>
    <h1># <%= page.tag %></h1>
    <p class="page-count"><%= page.posts.length %> 篇</p>
  </header>
  <%- partial('_partial/post-list') %>
</section>
<% } else { %>
<%
  const tags = site.tags.toArray().sort((a, b) => b.posts.length - a.posts.length);
%>
<section class="archive-page">
  <header class="page-head">
    <span class="page-kicker">TAGS</span>
    <h1>标签</h1>
    <p class="page-count"><%= tags.length %> tags</p>
  </header>
  <div class="tag-cloud">
    <% tags.forEach(function(tag) { %>
      <a href="<%- url_for(tag.path) %>"><%= tag.name %> <span>(<%= tag.posts.length %>)</span></a>
    <% }); %>
  </div>
</section>
<% } %>
