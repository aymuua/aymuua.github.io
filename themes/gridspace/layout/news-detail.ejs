<article class="news-detail">
  <header class="page-head">
    <span class="page-kicker">DAILY BRIEFING · <%= date(page.date, 'YYYY.MM.DD') %></span>
    <h1><%= page.title %></h1>
    <% if (page.description) { %><p class="page-deck"><%= page.description %></p><% } %>
  </header>
  <div class="news-prose post-content">
    <%- page.content %>
  </div>
  <a class="back-link" href="<%- url_for('/news/') %>">← 全部消息</a>
</article>
