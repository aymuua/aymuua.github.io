<header class="site-header" data-site-header>
  <div class="header-grid">
    <a class="brand" href="<%- url_for('/') %>" aria-label="<%= config.title %> 首页">
      <span class="brand-mark" aria-hidden="true">A—J</span>
      <span class="brand-name"><%= config.title %></span>
    </a>

    <div class="header-coordinate" aria-label="站点版本">
      <span>RESEARCH INDEX</span>
      <span>VOL. 01 / 2026</span>
    </div>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle>
      <span>菜单</span>
      <span class="menu-toggle-lines" aria-hidden="true"><i></i><i></i></span>
    </button>

    <nav class="site-navigation" id="site-navigation" aria-label="主导航" data-site-navigation>
      <% (theme.menu || []).forEach(function(item) { %>
        <a class="nav-link<%= is_current(item.url) ? ' is-current' : '' %>" href="<%- url_for(item.url) %>">
          <span><%= item.index %></span>
          <%= item.label %>
        </a>
      <% }); %>
    </nav>
  </div>
</header>
