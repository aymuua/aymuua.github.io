<header class="site-header">
  <a class="brand" href="<%- url_for('/') %>"><%= config.title %></a>
  <nav class="site-nav" id="site-navigation" aria-label="主导航" data-site-navigation>
    <% (theme.menu || []).forEach(function(item) { %>
      <a class="nav-link<%= is_current(item.url) ? ' is-current' : '' %>" href="<%- url_for(item.url) %>"><%= item.label %></a>
    <% }); %>
  </nav>
  <div class="header-actions">
    <button class="search-toggle" type="button" data-search-toggle>搜索 <span>⌘K</span></button>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-navigation">菜单</button>
  </div>
</header>
