<%
  const typeLabel = { note: '笔记', reflection: '心得', log: '日志' };
  const listedPosts = page.posts && page.posts.toArray
    ? page.posts.toArray()
    : site.posts.toArray();
%>
<ul class="post-list">
  <% listedPosts.forEach(function(post, index) { %>
    <li class="post-list-item">
      <a href="<%- url_for(post.path) %>">
        <span class="post-number"><%= String(index + 1).padStart(2, '0') %></span>
        <span class="post-date"><%= date(post.date, 'YYYY.MM.DD') %></span>
        <span class="post-title"><%= post.title %></span>
        <span class="post-type"><%= typeLabel[post.type] || '笔记' %></span>
      </a>
    </li>
  <% }); %>
</ul>
