<footer class="site-footer">
  <div class="spotify-player" data-spotify-player>
    <iframe
      src="https://open.spotify.com/embed/playlist/2clx6UddqXHPet6IJ3cv1c?utm_source=generator&theme=1"
      width="100%"
      height="152"
      frameborder="0"
      allowfullscreen
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="lazy"
    ></iframe>
  </div>
  <div class="footer-meta">
    <span>© <%= date(new Date(), 'YYYY') %> <%= config.author %></span>
    <span class="footer-note"><%= theme.footer_note %></span>
    <a class="footer-github" href="<%= theme.github_url %>" target="_blank" rel="noopener noreferrer">GitHub →</a>
  </div>
</footer>
