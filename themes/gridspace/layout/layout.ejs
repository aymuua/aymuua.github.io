<!doctype html>
<html lang="<%= config.language || 'zh-CN' %>">
<head>
  <%- partial('_partial/head') %>
</head>
<body class="layout-<%= page.layout || 'index' %>">
  <%- partial('_partial/header') %>
  <main id="main-content" class="site-main">
    <%- body %>
  </main>
  <%- partial('_partial/footer') %>

  <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>

  <div class="search-overlay" data-search-overlay aria-hidden="true">
    <div class="search-panel">
      <div class="search-head">
        <span class="search-title">搜索</span>
        <button class="search-close" type="button" data-search-close>关闭 ✕</button>
      </div>
      <input class="search-input" type="text" placeholder="输入关键词…" data-search-input autocomplete="off">
      <div class="search-results" data-search-results></div>
    </div>
  </div>

  <script src="<%- gridspace_asset_url('/js/site.js') %>" defer></script>
</body>
</html>
