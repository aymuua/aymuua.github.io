<%
  const typeLabel = { note: '笔记', reflection: '心得', log: '日志' };
  const currentType = typeLabel[page.type] || '笔记';

  const seriesDefs = (site.data && site.data.series) || [];
  const currentSeries = page.series ? seriesDefs.find(s => s.id === page.series) : null;

  const seriesPosts = page.series
    ? site.posts.toArray()
        .filter(p => p.series === page.series)
        .sort((a, b) => a.date - b.date)
    : [];
  const currentIndex = seriesPosts.findIndex(p => p.path === page.path);
  const prevPost = currentIndex > 0 ? seriesPosts[currentIndex - 1] : null;
  const nextPost = currentIndex >= 0 && currentIndex < seriesPosts.length - 1 ? seriesPosts[currentIndex + 1] : null;

  const postTags = page.tags && page.tags.toArray ? page.tags.toArray() : [];
  const articleToc = toc(page.content, {
    list_number: false,
    min_depth: 2,
    max_depth: 3
  });
%>
<article class="post">
  <header class="post-header">
    <div class="post-kicker">
      <span class="post-type">[<%= currentType %>]</span>
      <% if (currentSeries) { %>
        <span class="post-series">SERIES <%= currentSeries.index %> · <%= currentIndex + 1 %>/<%= seriesPosts.length %></span>
      <% } %>
    </div>
    <h1 class="post-title"><%= page.title %></h1>
    <% if (page.description) { %>
      <p class="post-deck"><%= page.description %></p>
    <% } %>
    <div class="post-meta">
      <span><%= date(page.date, 'YYYY.MM.DD') %></span>
      <% if (currentSeries) { %>
        <span aria-hidden="true">·</span>
        <span><%= currentSeries.name %></span>
      <% } %>
    </div>
  </header>

  <div class="post-layout">
    <div class="post-content">
      <%- page.content %>
    </div>
    <aside class="post-aside">
      <% if (articleToc) { %>
        <section class="aside-section">
          <p class="aside-label">CONTENTS</p>
          <nav class="article-toc" aria-label="本文目录">
            <%- articleToc %>
          </nav>
        </section>
      <% } %>
      <% if (currentSeries && seriesPosts.length > 1) { %>
        <section class="aside-section">
          <p class="aside-label">SERIES</p>
          <nav class="series-toc" aria-label="系列目录">
            <% seriesPosts.forEach(function(p, i) { %>
              <a class="<%= i === currentIndex ? 'is-current' : '' %>" href="<%- url_for(p.path) %>">
                <span class="series-toc-num"><%= String(i + 1).padStart(2, '0') %></span>
                <span class="series-toc-title"><%= p.title %></span>
              </a>
            <% }); %>
          </nav>
        </section>
      <% } %>
    </aside>
  </div>

  <footer class="post-footer">
    <% if (postTags.length) { %>
      <div class="post-tags">
        <% postTags.forEach(function(tag) { %>
          <a href="<%- url_for(tag.path) %>"><%= tag.name %></a>
        <% }); %>
      </div>
    <% } %>
    <nav class="post-pagination" aria-label="文章导航">
      <% if (prevPost) { %>
        <a class="pagination-prev" href="<%- url_for(prevPost.path) %>"><span>←</span> <%= prevPost.title %></a>
      <% } %>
      <% if (nextPost) { %>
        <a class="pagination-next" href="<%- url_for(nextPost.path) %>"><%= nextPost.title %> <span>→</span></a>
      <% } %>
    </nav>
  </footer>
</article>
