<%
  const plainText = strip_html(page.content || '').replace(/\s+/g, ' ').trim();
  const cjkCount = (plainText.match(/[\u3400-\u9fff]/g) || []).length;
  const latinCount = (plainText.replace(/[\u3400-\u9fff]/g, ' ').match(/\b[\w'-]+\b/g) || []).length;
  const readingMinutes = Math.max(1, Math.ceil(cjkCount / 450 + latinCount / 220));
  const postCategories = page.categories && page.categories.toArray ? page.categories.toArray() : [];
  const postTags = page.tags && page.tags.toArray ? page.tags.toArray() : [];
%>

<article class="article-page">
  <header class="article-hero grid-guides">
    <div class="article-kicker" data-reveal>
      <span>(NOTE)</span>
      <span><%= postCategories.length ? postCategories[0].name : 'RESEARCH' %></span>
    </div>
    <h1 data-reveal><%= page.title %></h1>
    <% if (page.description) { %>
      <p class="article-deck" data-reveal><%= page.description %></p>
    <% } %>
    <div class="article-hero-meta" data-reveal>
      <span>Published<br><strong><%= date(page.date, 'YYYY.MM.DD') %></strong></span>
      <span>Reading time<br><strong><%= readingMinutes %> min</strong></span>
      <span>Language<br><strong>ZH—CN</strong></span>
    </div>
  </header>

  <div class="article-grid">
    <aside class="article-aside">
      <div class="article-aside-inner">
        <p class="aside-label">ON THIS PAGE</p>
        <nav class="article-toc" aria-label="文章目录" data-toc>
          <ol data-toc-list></ol>
        </nav>

        <% if (postTags.length) { %>
          <div class="article-tags">
            <p class="aside-label">TAGS</p>
            <% postTags.forEach(function(tag) { %>
              <a href="<%- url_for(tag.path) %>"># <%= tag.name %></a>
            <% }); %>
          </div>
        <% } %>
      </div>
    </aside>

    <div class="article-content prose" id="article-content">
      <%- page.content %>
    </div>
  </div>

  <footer class="article-footer">
    <p>END OF NOTE / <%= date(page.date, 'YYYY') %></p>
    <div class="article-pagination">
      <% if (page.prev) { %>
        <a href="<%- url_for(page.prev.path) %>">
          <span>上一篇</span>
          <strong><%= page.prev.title %></strong>
        </a>
      <% } %>
      <% if (page.next) { %>
        <a href="<%- url_for(page.next.path) %>">
          <span>下一篇</span>
          <strong><%= page.next.title %></strong>
        </a>
      <% } %>
    </div>
  </footer>
</article>
