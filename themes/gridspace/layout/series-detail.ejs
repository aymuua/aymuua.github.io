<%
  const s = page.series || {};
  const typeLabel = { note: '笔记', reflection: '心得', log: '日志' };
  const posts = page.posts || [];
%>
<section class="archive-page">
  <header class="page-head">
    <span class="page-kicker">SERIES <%= s.index %></span>
    <h1><%= s.name %></h1>
    <% if (s.description) { %>
      <p class="page-deck"><%= s.description %></p>
    <% } %>
    <p class="page-count"><%= posts.length %> 篇 · <%= s.status %></p>
  </header>
  <div class="series-post-list">
    <% if (posts.length) { %>
      <% posts.forEach(function(post, i) { %>
        <a class="series-post-row" href="<%- url_for(post.path) %>">
          <span class="series-post-num"><%= String(i + 1).padStart(2, '0') %></span>
          <span class="series-post-date"><%= date(post.date, 'YYYY.MM.DD') %></span>
          <span class="series-post-title"><%= post.title %></span>
          <span class="series-post-type">[<%= typeLabel[post.type] || '笔记' %>]</span>
        </a>
      <% }); %>
    <% } else { %>
      <p class="series-empty">这个系列还没有文章。</p>
    <% } %>
  </div>
  <a class="back-link" href="<%- url_for('/series/') %>">← 全部系列</a>
</section>
