<%
  const seriesData = page.series || [];
  const totalPosts = seriesData.reduce(function(sum, s) { return sum + s.postCount; }, 0);
%>
<section class="archive-page">
  <header class="page-head">
    <span class="page-kicker">SERIES</span>
    <h1>系列</h1>
    <p class="page-count"><%= seriesData.length %> Series · <%= totalPosts %> 篇</p>
  </header>
  <div class="series-list">
    <% seriesData.forEach(function(s) { %>
      <a class="series-row" href="<%- url_for('/series/' + s.id + '/') %>">
        <span class="series-index"><%= s.index %></span>
        <span class="series-name"><%= s.name %></span>
        <span class="series-english"><%= s.english %></span>
        <span class="series-count"><%= s.postCount %> 篇</span>
      </a>
    <% }); %>
  </div>
</section>
