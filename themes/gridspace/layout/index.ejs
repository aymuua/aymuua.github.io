<%
  const hero = theme.hero || {};
%>
<section class="home-hero">
  <h1 class="hero-title"><%= hero.title %></h1>
  <p class="hero-note"><%= hero.note %></p>
</section>

<section class="home-latest">
  <div class="section-head">
    <span class="section-label">LATEST</span>
    <span class="section-meta"><%= date(new Date(), 'YYYY') %></span>
  </div>
  <%- partial('_partial/post-list') %>
</section>

<nav class="home-index" aria-label="次级导航">
  <a href="<%- url_for('/archives/') %>">归档</a>
  <span aria-hidden="true">·</span>
  <a href="<%- url_for('/tags/') %>">标签</a>
  <span aria-hidden="true">·</span>
  <a href="<%- url_for('/about/') %>">关于</a>
  <span aria-hidden="true">·</span>
  <a href="<%- url_for('/portfolio/') %>">作品集</a>
</nav>
