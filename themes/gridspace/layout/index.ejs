<%
  const hero = theme.hero || {};
%>
<section class="home-hero">
  <h1 class="hero-title"><%= hero.title %></h1>
  <p class="hero-note"><%= hero.note %></p>
</section>

<section class="home-latest">
  <div class="section-head">
    <span class="section-label">LATEST</span>
    <span class="section-meta"><%= date(new Date(), 'YYYY') %></span>
  </div>
  <%- partial('_partial/post-list') %>
</section>

<%
  const newsIssues = site.pages.toArray()
    .filter(function(item) { return item.news_issue === true; })
    .sort(function(a, b) { return b.date.valueOf() - a.date.valueOf(); })
    .slice(0, 3);
%>
<section class="home-news" aria-labelledby="home-news-title">
  <div class="section-head">
    <h2 class="section-label" id="home-news-title">最新消息学习</h2>
    <a class="section-meta" href="<%- url_for('/news/') %>">查看全部 →</a>
  </div>
  <% if (newsIssues.length) { %>
    <div class="news-list">
      <% newsIssues.forEach(function(issue) { %>
        <a class="news-row" href="<%- url_for(issue.path) %>">
          <time class="news-row-date" datetime="<%= date(issue.date, 'YYYY-MM-DD') %>"><%= date(issue.date, 'YYYY.MM.DD') %></time>
          <span class="news-row-title"><%= issue.title %></span>
          <span class="news-row-arrow" aria-hidden="true">↗</span>
        </a>
      <% }); %>
    </div>
  <% } else { %>
    <p class="news-empty">每日精选将在这里更新。</p>
  <% } %>
</section>

<nav class="home-index" aria-label="次级导航">
  <a href="<%- url_for('/news/') %>">最新消息学习</a>
  <span aria-hidden="true">·</span>
  <a href="<%- url_for('/archives/') %>">归档</a>
  <span aria-hidden="true">·</span>
  <a href="<%- url_for('/tags/') %>">标签</a>
  <span aria-hidden="true">·</span>
  <a href="<%- url_for('/about/') %>">关于</a>
  <span aria-hidden="true">·</span>
  <a href="<%- url_for('/portfolio/') %>">作品集</a>
</nav>
